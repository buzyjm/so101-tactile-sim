{
  "name": "so101-web-viewer",
  "version": "0.0.1",
  "description": "Simple viewport sample that streams a local Kit application.",
  "author": "Nvidia",
  "license": "SEE LICENSE IN LICENSE.txt",
  "private": true,
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "build": "vite build",
    "build:docs": "npx typedoc",
    "format": "npx prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "test": "mocha --require ts-node/register 'src/tests/**/*.{ts,tsx}'"
  },
  "dependencies": {
    "@nvidia/ov-web-rtc": "6.x"
  },
  "devDependencies": {
    "@types/chai": "^5.2.0",
    "@types/mocha": "^10.0.6",
    "chai": "^5.2.0",
    "mocha": "^10.2.0",
    "prettier": "^3.5.3",
    "prettier-plugin-brace-style": "^0.7.2",
    "ts-node": "^10.9.2",
    "typedoc": "^0.27.8",
    "vite": "^6.2.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
